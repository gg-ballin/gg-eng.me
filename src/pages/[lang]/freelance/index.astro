---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FreelanceEntry from '@/components/FreelanceEntry.astro';
import FreelanceBackButton from '@/components/FreelanceBackButton.astro';
import FreelanceSidebar from '@/components/FreelanceSidebar.astro';
import Reveal from '@/components/Reveal.astro';
import { getTranslations, type Language } from '@/i18n/translations';
import { getFreelanceEntries } from '@/lib/freelance-data';

const { lang } = Astro.params as { lang: Language };

if (!['es', 'en'].includes(lang)) {
  return Astro.redirect('/es/freelance');
}

const t = getTranslations(lang);
const fromParam = Astro.url.searchParams.get('from');
const freelanceEntries = getFreelanceEntries(lang);
---

<BaseLayout
  title={t.freelance.title}
  description={t.freelance.description}
  lang={lang}
>
  <div class="freelance-container">
    <FreelanceBackButton lang={lang} fromParam={fromParam} />

    <Reveal>
      <header class="freelance-header">
        <h1 data-page-heading class="freelance-heading">{t.freelance.heading}</h1>
        <p class="freelance-intro">{t.freelance.intro}</p>
      </header>
    </Reveal>

    <div class="freelance-layout">
      <div class="freelance-list freelance-list-animate">
        {freelanceEntries.map((entry) => (
          <FreelanceEntry entry={entry} lang={lang} />
        ))}
      </div>

      <aside class="freelance-sidebar-column freelance-sidebar-animate">
        <FreelanceSidebar lang={lang} entries={freelanceEntries} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .freelance-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 1rem;
    padding-bottom: 4rem;
  }

  .freelance-container :global(.reveal-root) {
    display: block;
    width: 100%;
    line-height: normal;
  }

  .freelance-container :global(.reveal-content) {
    display: block;
    width: 100%;
  }

  .freelance-header {
    margin-bottom: 3rem;
    max-width: 42rem;
  }

  .freelance-heading {
    font-family: var(--font-family-sans);
    font-size: 3rem;
    font-weight: 700;
    text-transform: lowercase;
    margin-bottom: 1.25rem;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .freelance-heading {
      font-size: 3.75rem;
    }
  }

  .freelance-intro {
    font-size: 1.125rem;
    line-height: 1.7;
    opacity: 0.9;
    margin: 0;
  }

  .freelance-layout {
    max-width: 1400px;
    display: flex;
    gap: 4rem;
    align-items: flex-start;
  }

  .freelance-list {
    flex: 1;
    min-width: 0;
    max-width: 900px;
  }

  .freelance-sidebar-column {
    width: 340px;
    flex-shrink: 0;
    position: sticky;
    top: 2rem;
  }

  .freelance-list-animate {
    animation: slideUpFromBottom 0.8s ease-out 0.2s both;
  }

  .freelance-sidebar-animate {
    animation: slideInFromRight 0.8s ease-out 0.3s both;
  }

  @keyframes slideUpFromBottom {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (max-width: 1024px) {
    .freelance-layout {
      flex-direction: column;
      gap: 3rem;
    }

    .freelance-sidebar-column {
      width: 100%;
      max-width: 42rem;
      position: static;
      order: -1;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    }

    .freelance-sidebar-animate {
      animation: slideUpFromBottom 0.8s ease-out 0.15s both;
    }
  }
</style>
