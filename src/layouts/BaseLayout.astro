---
import { getTranslations, type Language } from '@/i18n/translations';
import { getCurrentYear } from '@/utils/formatDate';
import { useUserAgent } from 'astro-useragent';
import { APP_VERSION } from '@/lib/version';
import ScanMeTag from '@/components/ScanMeTag.astro';
import { EmailService } from '@/lib/emailService';

interface Props {
  title: string;
  description?: string;
  lang: Language;
  hideSocialLinks?: boolean;
}

const { title = 'Germán Gomez', description = '', lang, hideSocialLinks = false } = Astro.props;
const currentPath = Astro.url.pathname;
const t = getTranslations(lang).nav;
const currentYear = getCurrentYear();

// Language switcher & nav paths (prefixed locales)
const otherLang = lang === 'es' ? 'en' : 'es';
const switcherPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

const bioPath = `/${lang}/`;
const experiencePath = `/${lang}/experience`;
const freelancePath = `/${lang}/freelance`;
const isExperienceLikePage =
  currentPath.startsWith(experiencePath) || currentPath.startsWith(freelancePath);
const blogPath = `/${lang}/blog`;
const contactPath = `/${lang}/contact`;

// QR code in popup must encode this URL so scans trigger the notification email (absolute URL)
const qrTargetUrl = `${Astro.url.origin}${currentPath}${currentPath.includes('?') ? '&' : '?'}from=qr`;
const qrImageUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=1&data=${encodeURIComponent(qrTargetUrl)}`;

// SSR-only: ?from=qr → one notification per 60s (cookie). Client fetch removed to avoid duplicates.
if (Astro.url.searchParams.get('from') === 'qr' && !Astro.cookies.get('qr_sent')?.value) {
  const apiKey = (Astro.locals.env?.RESEND_API_KEY as string | undefined) || import.meta.env.RESEND_API_KEY;
  if (apiKey) {
    try {
      const emailService = new EmailService(apiKey);
      const userAgent = Astro.request.headers.get('user-agent') ?? undefined;
      const country = Astro.request.headers.get('cf-ipcountry') ?? undefined;
      await emailService.sendQRScanNotification({ userAgent, path: currentPath, country });
      Astro.cookies.set('qr_sent', '1', { maxAge: 60, path: '/' });
    } catch (_) { /* no-op */ }
  }
}

// Detect if user is on desktop browser (not mobile) using server-side user agent
const uaString = Astro.request.headers.get('user-agent') ?? '';
let isDesktopBrowser = false;

// In dev mode, always show popup for testing (unless explicitly disabled)
if (import.meta.env.DEV) {
  isDesktopBrowser = true;
} else if (uaString) {
  // In production, use actual user-agent detection
  const userAgent = useUserAgent(uaString);
  isDesktopBrowser = !userAgent.isMobile && !userAgent.isTablet;
} else {
  // Fallback: if no user-agent in production, assume desktop (safer default)
  isDesktopBrowser = true;
}

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Theme initialization (runs before page render to prevent flash)
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      
      // Nav animation control - play on first visit or refresh
      const hasPlayedAnimation = sessionStorage.getItem('navAnimationPlayed');
      const isRefresh = performance.getEntriesByType('navigation')[0]?.type === 'reload';
      
      if (isRefresh || !hasPlayedAnimation) {
        document.documentElement.classList.add('play-nav-animation');
        sessionStorage.setItem('navAnimationPlayed', 'true');
      }
    </script>
  </head>
  <body class="min-h-screen">
    <nav class="nav-bar">
      <div class="nav-links">
        <a 
          href={bioPath}
          class={`nav-link nav-link-1 ${(currentPath === `/${lang}/` || currentPath === `/${lang}`) ? 'nav-link-active' : ''}`}
          aria-label={t.bio}
        >
          <span class="nav-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6"/>
            </svg>
          </span>
          <span class="nav-text">
            <span class="nav-label-desktop">{t.bio}</span>
            <span class="nav-label-mobile">{t.home}</span>
          </span>
        </a>
        <a 
          href={experiencePath}
          class={`nav-link nav-link-2 ${currentPath.startsWith(`/${lang}/experience`) || currentPath.startsWith(`/${lang}/freelance`) ? 'nav-link-active' : ''}`}
          aria-label={t.experience}
        >
          <span class="nav-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="7" width="18" height="13" rx="2"/>
              <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
              <path d="M3 12h18"/>
            </svg>
          </span>
          <span class="nav-text">{t.experience}</span>
        </a>
        <a 
          href={blogPath}
          class={`nav-link nav-link-3 ${currentPath.startsWith(`/${lang}/blog`) ? 'nav-link-active' : ''}`}
          aria-label={t.blog}
        >
          <span class="nav-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
            </svg>
          </span>
          <span class="nav-text">{t.blog}</span>
        </a>
        <a 
          href={contactPath}
          class={`nav-link nav-link-4 ${currentPath.startsWith(`/${lang}/contact`) ? 'nav-link-active' : ''}`}
          id="contact-nav-link"
          aria-label={t.contact}
        >
          <span class="nav-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="m3 7 9 6 9-6"/>
            </svg>
          </span>
          <span class="nav-text">{t.contact}</span>
        </a>
      </div>
    </nav>
    <header class={`site-top-bar ${hideSocialLinks ? 'site-top-bar--detail' : ''}`}>
