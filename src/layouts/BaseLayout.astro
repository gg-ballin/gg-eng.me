        )}
        <span class="sticky-page-title" data-sticky-title aria-hidden="true"></span>
      </div>
      <div id="nav-controls-glassy" class="nav-controls-glassy">
        <div class="nav-controls">
          <button id="theme-toggle" class="nav-control nav-control-1 theme-toggle-btn" aria-label={t.theme}>
            <span id="theme-icon" class="theme-icon-wrapper">
              <svg id="theme-icon-sun" class="theme-icon theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="4" fill="currentColor"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
              <svg id="theme-icon-moon" class="theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </span>
          </button>
          <a href={switcherPath} class="nav-control nav-control-2 lang-switcher">{otherLang}</a>
        </div>
      </div>
    </header>
    <!-- Language Change Loading Indicator -->
    <div id="language-loading" class="language-loading" style="display: none;" aria-hidden="true">
      <div class="language-loading-spinner"></div>
    </div>
    <!-- Sliding door: detail content rides in one-way (R→L / T→B) -->
    <div id="sliding-door" class="sliding-door" aria-hidden="true"></div>
    <main class={`main-content ${hideSocialLinks ? 'main-content--detail' : ''}`}>
      <slot />
    </main>
    
    <!-- Desktop Detection Popup with QR Code -->
    <div id="desktop-popup" class={`desktop-popup ${!isDesktopBrowser || isExperienceLikePage ? 'desktop-popup-hidden' : ''}`} role="dialog" aria-labelledby="desktop-popup-message" aria-hidden="true" data-is-desktop={isDesktopBrowser ? 'true' : 'false'}>
      <div class="desktop-popup-content">
        <button
          type="button"
          id="desktop-popup-size-toggle"
          class="desktop-popup-size-toggle"
          aria-label={getTranslations(lang).desktopPopup.minimize}
          data-label-minimize={getTranslations(lang).desktopPopup.minimize}
          data-label-open={getTranslations(lang).desktopPopup.open}
          aria-pressed="false"
          aria-controls="desktop-popup"
        >
          <svg class="desktop-popup-icon-shrink" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20"/>
            <polyline points="20 10 14 10 14 4"/>
            <line x1="14" y1="10" x2="21" y2="3"/>
            <line x1="3" y1="21" x2="10" y2="14"/>
          </svg>
          <svg class="desktop-popup-icon-expand" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9"/>
            <polyline points="9 21 3 21 3 15"/>
            <line x1="21" y1="3" x2="14" y2="10"/>
            <line x1="3" y1="21" x2="10" y2="14"/>
          </svg>
          <span class="desktop-popup-size-label desktop-popup-size-label-minimize">{getTranslations(lang).desktopPopup.minimize}</span>
          <span class="desktop-popup-size-label desktop-popup-size-label-open">{getTranslations(lang).desktopPopup.open}</span>
        </button>
        <p id="desktop-popup-message" class="desktop-popup-message">
          {getTranslations(lang).desktopPopup.message}
        </p>
        <div class="desktop-popup-qr-container">
          <div class="qr-code-frame">
            <img src={qrImageUrl} alt="QR Code" class="qr-code" width="200" height="200" />
          </div>
          <ScanMeTag label={getTranslations(lang).desktopPopup.scanMe} />
        </div>
      </div>
    </div>
    
    <!-- Recruiter Hint Popup with QR Code -->
    {!currentPath.startsWith(`/${lang}/contact`) && !isExperienceLikePage && (
      <div id="recruiter-hint-popup" class="recruiter-hint-popup" role="dialog" aria-labelledby="recruiter-hint-message" aria-hidden="true">
        <div class="recruiter-hint-popup-content">
          <p id="recruiter-hint-message" class="recruiter-hint-popup-message">
            <span class="recruiter-hint-desktop">
              👋{' '}
              <span
                class="recruiter-audience"
                data-audiences={JSON.stringify(getTranslations(lang).nav.recruiterHint.audiences)}
              >{getTranslations(lang).nav.recruiterHint.audiences[0]}</span>{getTranslations(lang).nav.recruiterHint.messageAfter}{' '}
              <a href={contactPath} class="recruiter-hint-link">{getTranslations(lang).nav.recruiterHint.linkText}</a>.
            </span>
            <span class="recruiter-hint-mobile">
              👋{' '}
              <span
                class="recruiter-audience"
                data-audiences={JSON.stringify(getTranslations(lang).nav.recruiterHint.audiences)}
              >{getTranslations(lang).nav.recruiterHint.audiences[0]}</span>{getTranslations(lang).nav.recruiterHint.mobileMessageAfter}{' '}
              <a href={contactPath} class="recruiter-hint-mobile-text">{getTranslations(lang).nav.recruiterHint.mobileLinkText}</a>.
            </span>
          </p>
        </div>
        <div class="recruiter-hint-popup-tail"></div>
      </div>
    )}
    
    <footer class={`footer ${isExperienceLikePage ? 'footer-experience' : ''}`}>
      {!hideSocialLinks && (
      <div class="social-links-container-footer">
        <a href="https://www.linkedin.com/in/german-gomez-781040152/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://github.com/gg-ballin" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
      )}
      <p class="footer-copyright">© {currentYear} {getTranslations(lang).footer.copyright}</p>
      <p class="footer-version">
        v{APP_VERSION}
      </p>
      <p class="footer-source">
        <a 
          href="https://github.com/gg-ballin/gg-eng.me" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="footer-link"
        >
          {getTranslations(lang).footer.viewSource} <span aria-hidden="true">→</span>
        </a>
      </p>
    </footer>

    <script>
      import { lockScroll, unlockScroll } from '@/lib/scroll-lock';

      (() => {
        const door = document.getElementById('sliding-door');
        if (!door) return;

        const DURATION_MS = window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 0
          : 600;
        let isAnimating = false;
        let overlayActive = false;
        let listTitle = document.title;
        let listUrl = window.location.href;
        let detailPopHandler = null;

        const topBar = document.querySelector('.site-top-bar');
        const topBarIsDetailLayout = topBar?.classList.contains('site-top-bar--detail') ?? false;

        const waitForDoorTransition = () =>
          new Promise((resolve) => {
            if (DURATION_MS === 0) {
              resolve();
              return;
            }
            let done = false;
            const finish = (event) => {
              if (event && event.target !== door) return;
              if (done) return;
              done = true;
              door.removeEventListener('transitionend', finish);
              resolve();
            };
            door.addEventListener('transitionend', finish);
            window.setTimeout(() => finish(), DURATION_MS + 80);
          });

        const DETAIL_STYLE_MARKERS = [
          'experience-detail',
          '.detail-',
          '.back-button',
          '.project-',
          'employer-logo',
          'article-',
          '.prose',
        ];

        const isDetailStyleText = (cssText) =>
          DETAIL_STYLE_MARKERS.some((marker) => cssText.includes(marker));

        const clearInjectedPageStyles = () => {
          document
            .querySelectorAll('[data-sliding-door-style="true"]')
            .forEach((el) => el.remove());
        };

        /**
         * Prod builds extract page CSS to <link rel="stylesheet">; astro dev keeps
         * it in <style>. Sliding-door only fetches HTML — inject both so detail
         * styles apply in Cloudflare Pages the same way they do locally.
         */
        const injectPageStyles = (doc) => {
          clearInjectedPageStyles();

          const existingHrefs = new Set(
            [...document.querySelectorAll('link[rel="stylesheet"]')].map((link) => link.href)
          );

          const pendingSheets = [];

          doc.querySelectorAll('link[rel="stylesheet"]').forEach((linkEl) => {
            const href = linkEl.getAttribute('href');
            if (!href) return;
            const absoluteHref = new URL(href, window.location.origin).href;
            if (existingHrefs.has(absoluteHref)) return;

            const clone = document.createElement('link');
            clone.rel = 'stylesheet';
            clone.href = absoluteHref;
            clone.setAttribute('data-sliding-door-style', 'true');
            pendingSheets.push(
              new Promise((resolve) => {
                clone.addEventListener('load', resolve, { once: true });
                clone.addEventListener('error', resolve, { once: true });
              })
            );
            document.head.appendChild(clone);
          });

          doc.querySelectorAll('style').forEach((styleEl) => {
            const cssText = styleEl.textContent || '';
            if (!isDetailStyleText(cssText)) return;
            const clone = styleEl.cloneNode(true);
            clone.setAttribute('data-sliding-door-style', 'true');
            document.head.appendChild(clone);
          });

          return Promise.all(pendingSheets);
        };

        const prepareDetailContent = (mainEl) => {
          mainEl.querySelectorAll('.experience-detail-animate, .article-animate').forEach((el) => {
            el.classList.remove('experience-detail-animate', 'article-animate');
            el.style.opacity = '1';
          });
        };

        const setOverlayUiState = (active) => {
          overlayActive = active;
          document.documentElement.classList.toggle('sliding-door-open', active);
          if (topBar) {
            if (active) {
              topBar.classList.add('site-top-bar--detail');
            } else if (!topBarIsDetailLayout) {
              topBar.classList.remove('site-top-bar--detail');
            }
          }
          if (active) {
            lockScroll('sliding-door');
          } else {
            unlockScroll('sliding-door');
          }
          document.dispatchEvent(new CustomEvent('sliding-door:change', { detail: { active } }));
        };

        const resolveFreelanceReturnPath = (fallbackPath) => {
          const stored = sessionStorage.getItem('freelanceReturnTo');
          const pageLang = document.documentElement.lang || 'es';
          if (stored === 'bio') return `/${pageLang}/`;
          if (stored === 'experience') return `/${pageLang}/experience`;
          return fallbackPath;
        };

        const patchFreelanceBackButtons = (root = document) => {
          const stored = sessionStorage.getItem('freelanceReturnTo') || 'experience';
          const pageLang = document.documentElement.lang || 'es';
          const target =
            stored === 'bio' ? `/${pageLang}/` : `/${pageLang}/experience`;

          root.querySelectorAll('[data-freelance-back]').forEach((el) => {
            el.setAttribute('href', target);
            el.dataset.listPath = target;
            el.dataset.experiencePath = target;
            el.dataset.returnOrigin = stored;
          });
        };

        /** Full-page detail only (not overlay). Browser back → list */
        const setupFullPageBackGuard = () => {
          if (detailPopHandler) {
            window.removeEventListener('popstate', detailPopHandler);
            detailPopHandler = null;
          }

          const backButton = document.querySelector('main.main-content [data-sliding-door-back]');
          const listPath = backButton?.dataset?.listPath || backButton?.dataset?.experiencePath;
          if (!listPath || overlayActive) return;

          history.pushState({ experienceDetailGuard: true }, '', window.location.href);
          detailPopHandler = () => {
            window.location.replace(listPath);
          };
          window.addEventListener('popstate', detailPopHandler);
        };

        const openDoorOverlay = async (listPath) => {
          if (!overlayActive || isAnimating) return;
          isAnimating = true;

          door.classList.remove('is-closed');
          await waitForDoorTransition();

          door.classList.remove('is-visible');
          door.innerHTML = '';
          door.setAttribute('aria-hidden', 'true');
          door.scrollTop = 0;
          clearInjectedPageStyles();
          setOverlayUiState(false);

          document.title = listTitle;

          const target = listPath || listUrl;
          if (target) {
            const targetHref = new URL(target, window.location.origin).href;
            if (window.location.href !== targetHref) {
              history.replaceState({ slidingDoor: false }, '', target);
            }
          }

          isAnimating = false;
        };

        const navigateWithDoor = async (href) => {
          if (isAnimating || overlayActive) return;
          isAnimating = true;

          listTitle = document.title;
          listUrl = window.location.href;

          try {
            const response = await fetch(href, { headers: { Accept: 'text/html' } });
            if (!response.ok) throw new Error(`Failed to fetch ${href}`);

            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const newMain = doc.querySelector('main.main-content');
            if (!newMain) throw new Error('No main.main-content in response');

            prepareDetailContent(newMain);
            await injectPageStyles(doc);

            door.innerHTML = newMain.innerHTML;
            patchFreelanceBackButtons(door);
            door.setAttribute('aria-hidden', 'false');
            door.classList.add('is-visible');
            door.scrollTop = 0;
            void door.offsetWidth;
            door.classList.add('is-closed');
            setOverlayUiState(true);

            await waitForDoorTransition();

            history.pushState({ slidingDoor: true }, '', href);
            document.title = doc.title || document.title;
          } catch (_) {
            window.location.assign(href);
          } finally {
            isAnimating = false;
          }
        };

        setupFullPageBackGuard();

        document.addEventListener('click', (event) => {
          const backBtn = event.target?.closest?.('[data-sliding-door-back]');
          if (backBtn) {
            const listPath = backBtn.dataset.listPath || backBtn.dataset.experiencePath;
            const forceNavigate = backBtn.dataset.slidingDoorBackNavigate === 'true';

            if (forceNavigate && listPath) {
              event.preventDefault();
              const targetPath = backBtn.hasAttribute('data-freelance-back')
                ? resolveFreelanceReturnPath(listPath)
                : listPath;
              setOverlayUiState(false);
              door.classList.remove('is-visible', 'is-closed');
              door.innerHTML = '';
              clearInjectedPageStyles();
              window.location.assign(targetPath);
              return;
            }

            if (overlayActive) {
              event.preventDefault();
              if (history.state && history.state.slidingDoor) {
                history.back();
              } else {
                openDoorOverlay(listPath);
              }
              return;
            }
          }

          const link = event.target?.closest?.('a[data-sliding-door]');
          if (!link || !link.href) return;
          if (event.defaultPrevented) return;
          if (event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          event.preventDefault();
          navigateWithDoor(link.href);
        });

        window.addEventListener('popstate', () => {
          if (history.state?.slidingDoor) return;
          if (overlayActive) {
            openDoorOverlay(listUrl);
          }
        });
      })();
    </script>

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      
      function updateThemeIcons() {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const sunEl = document.getElementById('theme-icon-sun');
        const moonEl = document.getElementById('theme-icon-moon');
        if (sunEl && moonEl) {
          sunEl.style.display = currentTheme === 'dark' ? 'block' : 'none';
          moonEl.style.display = currentTheme === 'dark' ? 'none' : 'block';
        }
      }
      
      updateThemeIcons();
      
      themeToggle?.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        
        themeToggle.style.transform = 'scale(0.9)';
        setTimeout(() => {
          themeToggle.style.transform = 'scale(1)';
        }, 100);
        
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateThemeIcons();
        
        // Dispatch custom event for theme change
        window.dispatchEvent(new CustomEvent('themeChange', { detail: { theme: newTheme } }));
        
        // Retrigger nav-links animation on theme change
        retriggerNavAnimations();
      });
      
      // Function to retrigger nav animations (init / lang / theme only — not detail back)
      function retriggerNavAnimations() {
        const html = document.documentElement;
        html.classList.remove('play-nav-animation');
        
        // Force reflow to reset animations
        void html.offsetWidth;
        
        // Re-add class to retrigger animations
        setTimeout(() => {
          html.classList.add('play-nav-animation');
        }, 10);
      }
      
      // Mark nav-controls as animated after first animation completes (prevent re-animation)
      const navControls = document.querySelectorAll('.nav-control');
      const markControlsAnimated = () => {
        navControls.forEach(control => {
          control.classList.add('nav-control-animated');
        });
      };
      
      // Mark as animated after max animation delay (0.7s + 0.5s = 1.2s)
      setTimeout(() => {
        markControlsAnimated();
      }, 1200);
      
      const hideLanguageLoading = () => {
        const loadingIndicator = document.getElementById('language-loading');
        if (loadingIndicator) {
          loadingIndicator.style.display = 'none';
        }
        sessionStorage.removeItem('languageChanging');
      };

      // Retrigger animations when language is changed (only nav-links, not controls)
      const langSwitcher = document.querySelector('.lang-switcher');
      langSwitcher?.addEventListener('click', () => {
        const loadingIndicator = document.getElementById('language-loading');
        if (loadingIndicator) {
          loadingIndicator.style.display = 'flex';
        }
        sessionStorage.setItem('languageChanging', 'true');
      });

      window.addEventListener('pageshow', hideLanguageLoading);
      window.addEventListener('popstate', hideLanguageLoading);

      const languageChanging = sessionStorage.getItem('languageChanging');
      if (languageChanging === 'true') {
        setTimeout(() => {
          hideLanguageLoading();
          retriggerNavAnimations();
        }, 300);
      }
      
      // Desktop detection popup (using server-side detection from astro-useragent)
      function showDesktopPopup() {
        const popup = document.getElementById('desktop-popup');
        
        // Only show if popup exists
        if (!popup) {
          if (import.meta.env.DEV) {
            console.log('[Desktop Popup] Popup not found');
          }
          return;
        }
        
        // Don't show on experience page
        if (window.location.pathname.includes('/experience') || window.location.pathname.includes('/freelance')) {
          if (import.meta.env.DEV) {
            console.log('[Desktop Popup] On experience page, skipping');
          }
          return;
        }
        
        // Check if popup has data-is-desktop attribute (server-side) or viewport is desktop (client fallback for UA misdetection e.g. Chrome)
        const serverDesktop = popup.getAttribute('data-is-desktop') === 'true';
        const viewportDesktop = window.innerWidth >= 768;
        const isDesktop = serverDesktop || viewportDesktop;
        
        if (import.meta.env.DEV) {
          console.log('[Desktop Popup] serverDesktop:', serverDesktop, 'viewportDesktop:', viewportDesktop, 'data-is-desktop:', popup.getAttribute('data-is-desktop'));
        }
        
        if (!isDesktop) {
          if (import.meta.env.DEV) {
            console.log('[Desktop Popup] Not desktop, skipping');
          }
          return;
        }
        
        // Remove hidden class if present
        popup.classList.remove('desktop-popup-hidden');
        
        // Allow clearing dismissal via URL param (dev and production, for testing)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('clear-popup') === 'true' || urlParams.get('show-popup') === '1') {
          localStorage.removeItem('desktop-popup-dismissed');
        }
        
        // Don't show if already dismissed (only in production; dev ignores so you can test repeatedly)
        const isDismissed = localStorage.getItem('desktop-popup-dismissed') === 'true';
        if (!import.meta.env.DEV && isDismissed) {
          return;
        }
        
        // Show popup after a short delay
        setTimeout(() => {
          popup.setAttribute('aria-hidden', 'false');
          popup.classList.add('desktop-popup-visible');

          // Restore compact preference
          if (localStorage.getItem('desktop-popup-compact') === 'true') {
            setDesktopPopupCompact(true);
          }
        }, 1500);
      }

      function setDesktopPopupCompact(compact) {
        const popup = document.getElementById('desktop-popup');
        const toggle = document.getElementById('desktop-popup-size-toggle');
        if (!popup || !toggle) return;

        popup.classList.toggle('is-compact', compact);
        toggle.classList.toggle('is-docked-out', compact);
        toggle.setAttribute('aria-pressed', compact ? 'true' : 'false');
        toggle.setAttribute(
          'aria-label',
          compact ? (toggle.dataset.labelOpen || 'open') : (toggle.dataset.labelMinimize || 'minimize')
        );
        localStorage.setItem('desktop-popup-compact', compact ? 'true' : 'false');
      }

      document.getElementById('desktop-popup-size-toggle')?.addEventListener('click', (event) => {
        event.stopPropagation();
        const popup = document.getElementById('desktop-popup');
        if (!popup) return;
        setDesktopPopupCompact(!popup.classList.contains('is-compact'));
      });
      
      // Recruiter hint popup - position near contact nav link on mobile, bottom right on desktop
      function showRecruiterHintPopup() {
        const popup = document.getElementById('recruiter-hint-popup');
        const contactLink = document.getElementById('contact-nav-link');
        
        if (!popup) {
          return;
        }
        
        // Don't show on experience page
        if (window.location.pathname.includes('/experience') || window.location.pathname.includes('/freelance')) {
          return;
        }
        
        // Remove hidden class if present
        popup.classList.remove('recruiter-hint-popup-hidden');
        
        // Position popup - CSS handles positioning, JS only manages transform for animation
        function positionPopup() {
          if (!popup) return;
          
          const isMobile = window.innerWidth < 768;
          
          if (isMobile) {
            // Mobile: CSS handles bottom/right positioning, JS only manages transform for animation
            // Don't override CSS positioning, just ensure transform is set for animation
            if (!popup.classList.contains('recruiter-hint-popup-visible')) {
              popup.style.transform = 'translateY(20px)';
            }
          } else {
            // Desktop: reset inline styles to let CSS handle it
            popup.style.bottom = '';
            popup.style.right = '';
            popup.style.left = '';
            popup.style.transform = '';
          }
        }
        
        // Position initially (mobile only)
        positionPopup();
        
        // Reposition on resize (mobile only) - use a single handler
        let resizeTimeout: ReturnType<typeof setTimeout> | null = null;
        const handleResize = () => {
          if (resizeTimeout) {
            clearTimeout(resizeTimeout);
          }
          resizeTimeout = setTimeout(() => {
            positionPopup();
          }, 100);
        };
        window.addEventListener('resize', handleResize, { passive: true });
        
        // Show popup after a short delay
        setTimeout(() => {
          if (!popup) return;
          
          if (import.meta.env.DEV) {
            console.log('[Recruiter Hint Popup] Showing popup now');
          }
          positionPopup(); // Position before showing
          popup.setAttribute('aria-hidden', 'false');
          popup.classList.add('recruiter-hint-popup-visible');
          startRecruiterAudienceRotation();
          
          // Reposition after a brief delay to ensure layout is stable
          setTimeout(() => {
            positionPopup();
          }, 100);
        }, 2000);
      }

      function startRecruiterAudienceRotation() {
        const nodes = document.querySelectorAll('.recruiter-audience');
        if (!nodes.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const intervalMs = reduceMotion ? 4000 : 2800;
        const swapMs = reduceMotion ? 0 : 320;

        nodes.forEach((node) => {
          let audiences = [];
          try {
            audiences = JSON.parse(node.getAttribute('data-audiences') || '[]');
          } catch (_) {
            audiences = [];
          }
          if (!Array.isArray(audiences) || audiences.length < 2) return;

          let index = 0;
          window.setInterval(() => {
            const next = (index + 1) % audiences.length;
            if (swapMs === 0) {
              index = next;
              node.textContent = audiences[index];
              return;
            }

            node.classList.add('is-exiting');
            window.setTimeout(() => {
              index = next;
              node.textContent = audiences[index];
              node.classList.remove('is-exiting');
              node.classList.add('is-entering');
              window.setTimeout(() => {
                node.classList.remove('is-entering');
              }, swapMs);
            }, swapMs);
          }, intervalMs);
        });
      }
      
      // QR code shake animation - shake entire popup
      function initQRShake() {
        const popupContent = document.querySelector('.desktop-popup-content');
        if (!popupContent) return;
        
        setInterval(() => {
          popupContent.classList.add('qr-shake');
          setTimeout(() => {
            popupContent.classList.remove('qr-shake');
          }, 500);
        }, 5000);
      }
      
      // Overlap detection for popups
      function checkPopupOverlap(popup: HTMLElement | null, importantContentSelectors: string[]): boolean {
        if (!popup || (!popup.classList.contains('desktop-popup-visible') && !popup.classList.contains('recruiter-hint-popup-visible'))) {
          return false;
        }
        
        const popupRect = popup.getBoundingClientRect();
        const importantElements = document.querySelectorAll(importantContentSelectors.join(','));
        
        for (const element of importantElements) {
          const elementRect = element.getBoundingClientRect();
          
          // Check if popup overlaps with element
          const overlaps = !(
            popupRect.right < elementRect.left ||
            popupRect.left > elementRect.right ||
            popupRect.bottom < elementRect.top ||
            popupRect.top > elementRect.bottom
          );
          
          if (overlaps) {
            return true;
          }
        }
        
        return false;
      }
      
      // Apply overlap opacity to popups
      function updatePopupOpacity() {
        const desktopPopup = document.getElementById('desktop-popup');
        const recruiterPopup = document.getElementById('recruiter-hint-popup');
        
        // Important content areas to check
        const importantSelectors = [
          '.main-content',
          '.skills-column',
          '.experience-column',
          '.experience-layout',
          'aside',
          'section'
        ];
        
        if (desktopPopup) {
          const overlaps = checkPopupOverlap(desktopPopup, importantSelectors);
          desktopPopup.style.opacity = overlaps ? '0.2' : '1';
        }
        
        if (recruiterPopup) {
          const overlaps = checkPopupOverlap(recruiterPopup, importantSelectors);
          recruiterPopup.style.opacity = overlaps ? '0.2' : '1';
        }
      }
      
      // Throttled overlap check
      let overlapCheckTimeout: number | null = null;
      function scheduleOverlapCheck() {
        if (overlapCheckTimeout) {
          cancelAnimationFrame(overlapCheckTimeout);
        }
        overlapCheckTimeout = requestAnimationFrame(updatePopupOpacity);
      }
      
      // Initialize overlap detection
      function initOverlapDetection() {
        // Check on scroll
        window.addEventListener('scroll', scheduleOverlapCheck, { passive: true });
        
        // Check on resize
        window.addEventListener('resize', scheduleOverlapCheck, { passive: true });
        
        // Initial check
        setTimeout(updatePopupOpacity, 2000);
        
        // Check periodically (every 500ms) to catch dynamic content changes
        setInterval(updatePopupOpacity, 500);
      }
      
      // Initialize popup when DOM is ready
      function initPopup() {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => {
            showDesktopPopup();
            showRecruiterHintPopup();
            initQRShake();
            initOverlapDetection();
          });
        } else {
          showDesktopPopup();
          showRecruiterHintPopup();
          initQRShake();
          initOverlapDetection();
        }
      }
      
      // Initialize on page load
      initPopup();
      
      // Re-initialize on route changes (Astro view transitions or navigation)
      // Listen for navigation events to show popup on new pages if not dismissed
      let popupInitialized = false;
      const observer = new MutationObserver(() => {
        const popup = document.getElementById('desktop-popup');
        if (popup && !popupInitialized) {
          const dismissed = localStorage.getItem('desktop-popup-dismissed');
          if (dismissed !== 'true') {
            popupInitialized = true;
            showDesktopPopup();
          }
        }
      });
      
      // Observe body for changes (route navigation)
      observer.observe(document.body, { childList: true, subtree: true });
      
      // Also listen for Astro navigation events
      document.addEventListener('astro:page-load', () => {
        popupInitialized = false;
        setTimeout(() => {
          showDesktopPopup();
          showRecruiterHintPopup();
          initQRShake();
          initOverlapDetection();
        }, 100);
      });
      
      // Glassy effect for nav controls on scroll (mobile only)
      function setupGlassyNavControls() {
        const topBar = document.querySelector('.site-top-bar');
        const glassyWrapper = document.getElementById('nav-controls-glassy');
        if (!topBar && !glassyWrapper) return;
        
        let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
        
        function handleScroll() {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          const door = document.getElementById('sliding-door');
          const doorScrollY = door?.classList.contains('is-closed') ? door.scrollTop : 0;
          const isScrolled = scrollY > 24 || doorScrollY > 24;

          if (window.innerWidth >= 768) {
            topBar?.classList.toggle('scrolled', isScrolled);
            glassyWrapper?.classList.remove('scrolled');
            return;
          }

          topBar?.classList.toggle('scrolled', isScrolled);
          glassyWrapper?.classList.toggle('scrolled', isScrolled);
        }
        
        // Initial check
        handleScroll();
        
        // Throttle scroll events
        window.addEventListener('scroll', () => {
          if (scrollTimeout) {
            clearTimeout(scrollTimeout);
          }
          scrollTimeout = setTimeout(handleScroll, 10);
        }, { passive: true });

        document.getElementById('sliding-door')?.addEventListener('scroll', handleScroll, { passive: true });
        
        // Handle resize
        window.addEventListener('resize', handleScroll, { passive: true });
        
        // Re-setup on page navigation
        document.addEventListener('astro:page-load', () => {
          setTimeout(handleScroll, 100);
        });
      }
      
      // Initialize glassy nav controls
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupGlassyNavControls);
      } else {
        setupGlassyNavControls();
      }

      function setupStickyPageTitle() {
        const sticky = document.querySelector('[data-sticky-title]');
        if (!sticky) return;

        let headingObserver: IntersectionObserver | null = null;

        const disconnectObserver = () => {
          headingObserver?.disconnect();
          headingObserver = null;
        };

        const bindHeadingSource = () => {
          disconnectObserver();

          const door = document.getElementById('sliding-door');
          const doorOpen = door?.classList.contains('is-closed') ?? false;
          const source = doorOpen
            ? door?.querySelector('[data-page-heading]')
            : document.querySelector('main.main-content [data-page-heading]');

          if (!(source instanceof HTMLElement)) {
            sticky.textContent = '';
            sticky.classList.remove('is-visible');
            sticky.setAttribute('aria-hidden', 'true');
            document.querySelector('[data-header-pill]')?.classList.remove('header-context-pill--with-title');
            return;
          }

          sticky.textContent = source.textContent?.trim() ?? '';
          sticky.setAttribute('aria-hidden', 'true');

          headingObserver = new IntersectionObserver(
            ([entry]) => {
              const visible = !entry.isIntersecting;
              sticky.classList.toggle('is-visible', visible);
              sticky.setAttribute('aria-hidden', visible ? 'false' : 'true');
              document.querySelector('[data-header-pill]')?.classList.toggle('header-context-pill--with-title', visible);
            },
            {
              root: doorOpen ? door : null,
              rootMargin: '-56px 0px 0px 0px',
              threshold: 0,
            }
          );

          headingObserver.observe(source);
        };

        bindHeadingSource();

        window.addEventListener('resize', bindHeadingSource, { passive: true });
        document.addEventListener('sliding-door:change', () => {
          const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 650;
          window.setTimeout(bindHeadingSource, delay);
        });
        document.addEventListener('astro:page-load', () => {
          window.setTimeout(bindHeadingSource, 100);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupStickyPageTitle);
      } else {
        setupStickyPageTitle();
      }

      function scrollToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        document.getElementById('sliding-door')?.scrollTo({ top: 0, behavior: 'smooth' });
      }

      if (!document.documentElement.dataset.scrollToTopInit) {
        document.documentElement.dataset.scrollToTopInit = 'true';

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const activeNav = target.closest('.nav-link.nav-link-active');
          if (activeNav instanceof HTMLAnchorElement) {
            const href = activeNav.getAttribute('href');
            if (href) {
              const targetPath = new URL(href, window.location.origin).pathname;
              if (targetPath === window.location.pathname) {
                event.preventDefault();
                scrollToTop();
                return;
              }
            }
          }

          if (target.closest('#theme-toggle')) {
            if ((window.scrollY || document.documentElement.scrollTop) > 0) {
              scrollToTop();
            }
            return;
          }

          if (target.closest('.site-top-bar') && !target.closest('a[target="_blank"]') && !target.closest('.lang-switcher')) {
            if ((window.scrollY || document.documentElement.scrollTop) > 0) {
              scrollToTop();
            }
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  
  /* Ensure full width and prevent horizontal overflow */
  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }
  
  /* Mobile-first: bottom tab bar — glossy glass */
  .nav-bar {
    position: fixed;
    left: 0;
