  /* Desktop-only nav animations (sidebar as it was) */
  @media (min-width: 768px) {
    .play-nav-animation .nav-link {
      opacity: 0;
      animation: slideFromOutside 0.6s ease-out forwards;
    }
    
    .play-nav-animation .nav-link-1 {
      animation-delay: 0.1s;
    }
    
    .play-nav-animation .nav-link-2 {
      animation-delay: 0.25s;
    }
    
    .play-nav-animation .nav-link-3 {
      animation-delay: 0.4s;
    }
    
    .play-nav-animation .nav-link-4 {
      animation-delay: 0.55s;
    }
    
    .play-nav-animation .nav-control:not(.nav-control-animated) {
      opacity: 0;
      animation: scaleFromInside 0.5s ease-out forwards;
    }
    
    .play-nav-animation .nav-control-1:not(.nav-control-animated) {
      animation-delay: 0.55s;
    }
    
    .play-nav-animation .nav-control-2:not(.nav-control-animated) {
      animation-delay: 0.7s;
