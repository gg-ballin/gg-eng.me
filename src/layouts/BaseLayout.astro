  }
  
  /* Override glow on desktop */
  @media (min-width: 768px) {
    .nav-bar {
      box-shadow: 
        4px 0 12px rgba(99, 102, 241, 0.15),
        2px 0 4px var(--color-accent);
      animation: navGlowPulse 3s ease-in-out infinite;
    }
    
    [data-theme="dark"] .nav-bar {
