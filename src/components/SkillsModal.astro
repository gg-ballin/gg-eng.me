---
import SkillsSection from './SkillsSection.astro';
import LanguagesSection from './LanguagesSection.astro';
import type { SkillsData } from '@/lib/experience-data';
import { getCategoryDisplayName } from '@/lib/experience-data';
import type { ExperienceTechCategory } from '@/lib/experience/technologies';

interface Props {
  skillsData: SkillsData;
  translations: {
    softSkills: string;
    languages: string;
    close: string;
  };
  lang: 'es' | 'en';
}

const { skillsData, translations, lang } = Astro.props;

const categoriesWithSkills = (Object.keys(skillsData.hardSkillsByCategory) as ExperienceTechCategory[]).filter(
  (category) => skillsData.hardSkillsByCategory[category].length > 0
);
---

<div id="skills-modal" class="skills-modal" role="dialog" aria-labelledby="skills-modal-title" aria-hidden="true">
  <div class="skills-modal-backdrop" id="skills-modal-backdrop"></div>
  <div class="skills-modal-content" id="skills-modal-content">
    <div class="skills-modal-drag-handle" aria-hidden="true"></div>
    <div class="skills-modal-header">
      <h2 id="skills-modal-title" class="skills-modal-title">Skills</h2>
      <button class="skills-modal-close" id="skills-modal-close" aria-label={translations.close}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="skills-modal-body">
      {categoriesWithSkills.map((category) => (
        <SkillsSection 
          title={getCategoryDisplayName(category, lang)}
          skills={skillsData.hardSkillsByCategory[category]}
          useIcons={true}
          linkBadges={true}
          lang={lang}
        />
      ))}
      <SkillsSection 
        title={translations.softSkills}
        skills={skillsData.softSkills}
        useIcons={false}
        linkBadges={true}
        lang={lang}
      />
      <LanguagesSection 
        languages={skillsData.languages}
        title={translations.languages}
      />
    </div>
  </div>
</div>

<style>
  .skills-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  
  .skills-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }
  
  .skills-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    touch-action: none;
  }
  
  .skills-modal-content {
    position: relative;
    width: 100%;
    height: 80vh;
    max-height: 80vh;
    background-color: var(--color-bg);
    border-top: 3px solid var(--color-text);
    border-radius: 1rem 1rem 0 0;
    padding: 0.75rem 1.5rem 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    will-change: transform;
  }

  .skills-modal-content.is-dragging {
    transition: none;
  }
  
  .skills-modal[aria-hidden="false"] .skills-modal-content {
    transform: translateY(0);
  }

  .skills-modal-drag-handle {
    width: 2.5rem;
    height: 0.25rem;
    margin: 0.25rem auto 0.75rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-text) 35%, transparent);
    flex-shrink: 0;
  }
  
  .skills-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-border);
  }
  
  .skills-modal-title {
    font-family: var(--font-family-sans);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: lowercase;
  }
  
  .skills-modal-close {
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }
  
  .skills-modal-close:hover {
    transform: scale(1.1);
  }
  
  .skills-modal-close:active {
    transform: scale(0.95);
  }
  
  .skills-modal-body {
    padding-bottom: 2rem;
  }
  
  @media (min-width: 768px) {
    .skills-modal {
      display: none;
    }
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '@/lib/scroll-lock';

  (function () {
    const modal = document.getElementById('skills-modal');
    const backdrop = document.getElementById('skills-modal-backdrop');
    const closeBtn = document.getElementById('skills-modal-close');
    const toggleBtn = document.getElementById('skills-modal-toggle');
    const content = document.getElementById('skills-modal-content');

    if (!modal || !backdrop || !closeBtn || !content) return;

    const modalElement = modal;
    const contentElement = content;
    const DISMISS_THRESHOLD = 100;
    let skipHistorySync = false;
    let dragStartY = 0;
    let dragOffset = 0;
    let isDragging = false;

    function isOpen(): boolean {
      return modalElement.getAttribute('aria-hidden') === 'false';
    }

    function resetSheetTransform(): void {
      contentElement.classList.remove('is-dragging');
      contentElement.style.removeProperty('transform');
    }

    function openModal(): void {
      modalElement.setAttribute('aria-hidden', 'false');
      lockScroll('skills-modal');
      toggleBtn?.setAttribute('aria-expanded', 'true');

      if (!history.state?.skillsModal) {
        history.pushState({ skillsModal: true }, '');
      }
    }

    function closeModal(fromPopState = false): void {
      if (!isOpen()) return;

      modalElement.setAttribute('aria-hidden', 'true');
      unlockScroll('skills-modal');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      resetSheetTransform();

      if (!fromPopState && history.state?.skillsModal) {
        skipHistorySync = true;
        history.back();
      }
    }

    function setupSwipeDismiss(): void {
      contentElement.addEventListener(
        'touchstart',
        (event) => {
          if (!isOpen() || event.touches.length !== 1) return;
          if (contentElement.scrollTop > 0) return;

          isDragging = true;
          dragStartY = event.touches[0].clientY;
          dragOffset = 0;
          contentElement.classList.add('is-dragging');
        },
        { passive: true }
      );

      contentElement.addEventListener(
        'touchmove',
        (event) => {
          if (!isDragging || event.touches.length !== 1) return;

          const deltaY = event.touches[0].clientY - dragStartY;
          if (deltaY <= 0) {
            dragOffset = 0;
            contentElement.style.transform = 'translateY(0)';
            return;
          }

          dragOffset = deltaY;
          contentElement.style.transform = `translateY(${deltaY}px)`;
          event.preventDefault();
        },
        { passive: false }
      );

      const finishDrag = (): void => {
        if (!isDragging) return;

        isDragging = false;
        contentElement.classList.remove('is-dragging');

        if (dragOffset >= DISMISS_THRESHOLD) {
          closeModal();
          return;
        }

        resetSheetTransform();
        dragOffset = 0;
      };

      contentElement.addEventListener('touchend', finishDrag, { passive: true });
      contentElement.addEventListener('touchcancel', finishDrag, { passive: true });
    }

    closeBtn.addEventListener('click', () => closeModal());
    backdrop.addEventListener('click', () => closeModal());

    toggleBtn?.addEventListener('click', () => {
      if (isOpen()) {
        closeModal();
      } else {
        openModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        closeModal();
      }
    });

    window.addEventListener('popstate', () => {
      if (skipHistorySync) {
        skipHistorySync = false;
        return;
      }

      if (isOpen()) {
        closeModal(true);
      }
    });

    setupSwipeDismiss();
  })();
</script>
