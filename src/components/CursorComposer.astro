---
import { getTranslations, type Language } from '../i18n/translations';

interface Props {
  lang: Language;
  variant?: 'desktop' | 'mobile';
}

const { lang, variant = 'desktop' } = Astro.props;
const t = getTranslations(lang).bio.cursorComposer;

const modes = [
  { slug: 'agent', label: 'Agent' },
  { slug: 'ask', label: 'Ask' },
  { slug: 'plan', label: 'Plan' },
  { slug: 'multitask', label: 'Multitask' },
] as const;

const models = [
  {
    slug: 'opus',
    label: 'Claude Opus 5',
    icon: '/assets/icons/tech/claude/claude_logo.svg',
  },
  {
    slug: 'fable',
    label: 'Claude Fable 5',
    icon: '/assets/icons/tech/claude/claude_logo.svg',
  },
  {
    slug: 'composer',
    label: 'Composer 2.5',
    icon: '/assets/icons/tech/cursor/cursor_mark.svg',
    theme: true,
  },
  {
    slug: 'kimi',
    label: 'Kimi K3',
    icon: '/assets/icons/tech/kimi/kimi_logo_dark.svg',
    theme: true,
  },
  {
    slug: 'deepseek',
    label: 'deepseek v4 pro',
    icon: '/assets/icons/tech/deepseek/deepseek_logo.svg',
  },
  {
    slug: 'gpt',
    label: 'GPT-5.6-Sol',
    icon: '/assets/icons/tech/openai/openai_logo.svg',
    theme: true,
  },
  {
    slug: 'terra',
    label: 'Terra',
    icon: '/assets/icons/tech/openai/openai_logo.svg',
    theme: true,
  },
] as const;
---

<aside
  class={`bio-cursor-composer bio-cursor-composer--${variant}`}
  aria-label={`${modes.map((mode) => mode.label).join(', ')}; ${t.modelsLabel}: ${models.map((model) => model.label).join(', ')}`}
>
  <div class="bio-cursor-shell">
    <p
      class="bio-cursor-placeholder"
      data-bio-cursor-typewriter
      data-prompts={JSON.stringify(t.prompts)}
      aria-live="polite"
    >
      <span class="bio-cursor-typewriter-text"></span>
      <span class="bio-cursor-caret" aria-hidden="true"></span>
    </p>

    <div class="bio-cursor-toolbar">
      <div class="bio-cursor-pills">
        <span class="bio-cursor-pill bio-cursor-pill--mode">
          <span class="bio-cursor-mode" data-bio-cursor-mode aria-hidden="true">
            {modes.map((mode) => (
              <span
                class={`bio-cursor-mode-word bio-cursor-mode-word--${mode.slug}`}
                data-mode-slug={mode.slug}
              >
                {mode.slug === 'agent' && (
                  <svg class="bio-cursor-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {mode.slug === 'ask' && (
                  <svg class="bio-cursor-icon" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                      d="M3.2 2.5h9.6c.7 0 1.2.5 1.2 1.2v6.2c0 .7-.5 1.2-1.2 1.2H8.1L5.4 13.4a.4.4 0 0 1-.7-.3v-2H3.2c-.7 0-1.2-.5-1.2-1.2V3.7c0-.7.5-1.2 1.2-1.2Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {mode.slug === 'plan' && (
                  <svg class="bio-cursor-icon" viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="3.2" cy="5" r="1.15" fill="none" stroke="currentColor" stroke-width="1.2" />
                    <circle cx="3.2" cy="11" r="1.15" fill="none" stroke="currentColor" stroke-width="1.2" />
                    <path d="M6.2 5h6.6M6.2 11h6.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  </svg>
                )}
                {mode.slug === 'multitask' && (
                  <svg class="bio-cursor-icon" viewBox="0 0 16 16" aria-hidden="true">
                    <rect x="1.8" y="2.2" width="7.2" height="7.2" rx="1.1" fill="none" stroke="currentColor" stroke-width="1.25" />
                    <rect x="7" y="6.6" width="7.2" height="7.2" rx="1.1" fill="none" stroke="currentColor" stroke-width="1.25" />
                  </svg>
                )}
                <span>{mode.label}</span>
                <svg class="bio-cursor-chevron" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M3 4.5 6 8l3-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            ))}
          </span>
        </span>

        <span class="bio-cursor-pill bio-cursor-pill--model">
          <span class="bio-cursor-model" aria-hidden="true">
            {models.map((model) => (
              <span class={`bio-cursor-model-word bio-cursor-model-word--${model.slug}`}>
                {'theme' in model && model.theme ? (
                  <span
                    class="bio-cursor-model-logo bio-cursor-model-logo--theme"
                    style={`--bio-model-logo: url('${model.icon}')`}
                  />
                ) : (
                  <img
                    class="bio-cursor-model-logo"
                    src={model.icon}
                    alt=""
                    width="14"
                    height="14"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span>{model.label}</span>
              </span>
            ))}
          </span>
          <svg class="bio-cursor-chevron" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M3 4.5 6 8l3-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>

      <div class="bio-cursor-actions" aria-hidden="true">
        <svg class="bio-cursor-action" viewBox="0 0 16 16">
          <path
            d="M12.4 8.6 8.1 12.9a3 3 0 0 1-4.3-4.2l5.2-5.2a2 2 0 0 1 2.8 2.8L6.6 11.5a1 1 0 1 1-1.4-1.4l4.6-4.6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <svg class="bio-cursor-action" viewBox="0 0 16 16">
          <path
            d="M8 2.5a2 2 0 0 0-2 2v4a2 2 0 1 0 4 0v-4a2 2 0 0 0-2-2Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
          />
          <path
            d="M4.5 8.2a3.5 3.5 0 0 0 7 0M8 11.7v1.8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
        </svg>
      </div>
    </div>
  </div>
</aside>

<style>
  @font-face {
    font-family: "Cursor Gothic";
    src: url("/fonts/cursor/CursorGothic-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Cursor Gothic";
    src: url("/fonts/cursor/CursorGothic-Bold.woff2") format("woff2");
    font-weight: 500 700;
    font-style: normal;
    font-display: swap;
  }

  .bio-cursor-composer {
    font-family: "Cursor Gothic", var(--font-family-sans), sans-serif;
  }
</style>

<script>
  type TypewriterHandle = { stop: () => void };

  const typewriterHandles = new WeakMap<HTMLElement, TypewriterHandle>();

  function measureBioCursorModes() {
    document.querySelectorAll('[data-bio-cursor-mode]').forEach((modeEl) => {
      if (!(modeEl instanceof HTMLElement)) return;
      const words = modeEl.querySelectorAll('[data-mode-slug]');
      if (!words.length) return;

      // Pause the pill's color animation too, so that when measuring ends all
      // three animations (color, width, word fade) restart in the same phase.
      const pill = modeEl.closest('.bio-cursor-pill--mode');

      modeEl.classList.add('is-measuring');
      pill?.classList.add('is-measuring');

      words.forEach((word) => {
        if (!(word instanceof HTMLElement)) return;
        const slug = word.dataset.modeSlug;
        if (!slug) return;
        const width = Math.ceil(word.scrollWidth);
        // Skip hidden instances (display: none reports 0); re-measured on resize.
        if (width > 0) {
          modeEl.style.setProperty(`--mode-w-${slug}`, `${width}px`);
        }
      });

      modeEl.classList.remove('is-measuring');
      pill?.classList.remove('is-measuring');
    });
  }

  function parsePrompts(raw: string | undefined): string[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed)
        ? parsed.filter((item): item is string => typeof item === 'string' && item.length > 0)
        : [];
    } catch {
      return [];
    }
  }

  function startTypewriter(el: HTMLElement): TypewriterHandle {
    const textEl = el.querySelector('.bio-cursor-typewriter-text');
    const prompts = parsePrompts(el.dataset.prompts);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!(textEl instanceof HTMLElement) || !prompts.length) {
      return { stop: () => undefined };
    }

    if (reduceMotion) {
      textEl.textContent = prompts[0] ?? '';
      return { stop: () => undefined };
    }

    let promptIndex = 0;
    let charIndex = 0;
    let deleting = false;
    let timer: number | undefined;
    let stopped = false;

    const TYPE_MS = 42;
    const DELETE_MS = 24;
    const HOLD_MS = 1600;
    const GAP_MS = 420;

    const tick = () => {
      if (stopped) return;
      const prompt = prompts[promptIndex] ?? '';

      if (!deleting) {
        charIndex = Math.min(charIndex + 1, prompt.length);
        textEl.textContent = prompt.slice(0, charIndex);
        if (charIndex === prompt.length) {
          deleting = true;
          timer = window.setTimeout(tick, HOLD_MS);
          return;
        }
        timer = window.setTimeout(tick, TYPE_MS);
        return;
      }

      charIndex = Math.max(charIndex - 1, 0);
      textEl.textContent = prompt.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        promptIndex = (promptIndex + 1) % prompts.length;
        timer = window.setTimeout(tick, GAP_MS);
        return;
      }
      timer = window.setTimeout(tick, DELETE_MS);
    };

    timer = window.setTimeout(tick, 500);

    return {
      stop: () => {
        stopped = true;
        if (timer !== undefined) window.clearTimeout(timer);
      },
    };
  }

  function initTypewriters() {
    document.querySelectorAll('[data-bio-cursor-typewriter]').forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      typewriterHandles.get(node)?.stop();
      typewriterHandles.set(node, startTypewriter(node));
    });
  }

  const run = () => {
    initTypewriters();
    if (document.fonts?.ready) {
      document.fonts.ready.then(measureBioCursorModes);
    } else {
      measureBioCursorModes();
    }
  };

  run();
  document.addEventListener('astro:page-load', run);
  window.addEventListener('resize', measureBioCursorModes);
</script>
