---
import type { Platform } from '@/lib/freelance-data';
import type { Language } from '@/i18n/translations';
import { getTranslations } from '@/i18n/translations';

interface Props {
  platform: Platform;
  lang: Language;
}

const { platform, lang } = Astro.props;
const label = getTranslations(lang).freelance.platforms[platform];
---

<span class="platform-badge" data-platform={platform}>
  {platform === 'android' && (
    <svg class="platform-badge-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M17.523 15.34c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25zm-11.046 0c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25zm11.404-6.02l1.957-3.39a.426.426 0 00-.155-.582.426.426 0 00-.582.155l-1.988 3.442A10.45 10.45 0 0012 8.5c-1.74 0-3.37.42-4.813 1.165L5.2 6.223a.426.426 0 00-.582-.155.426.426 0 00-.155.582l1.957 3.39C3.68 11.05 1.85 13.98 1.6 17.4h20.8c-.25-3.42-2.08-6.35-4.519-8.08z"/>
    </svg>
  )}
  {platform === 'ios' && (
    <svg class="platform-badge-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
  )}
  {label}
</span>

<style>
  .platform-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-family-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.125rem 0.5rem;
    border: 2px solid var(--color-text);
    color: var(--color-text);
    line-height: 1.4;
    background-color: var(--color-bg);
  }

  .platform-badge-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  .platform-badge[data-platform='web'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
