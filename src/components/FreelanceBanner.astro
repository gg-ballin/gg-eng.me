---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { appendFreelanceOrigin } from '@/lib/freelance-navigation';
import { getFreelanceEntries } from '@/lib/freelance-data';
import type { Language } from '@/i18n/translations';
import { getTranslations } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang).freelance;
const projectCount = getFreelanceEntries(lang).length;
const freelancePath = appendFreelanceOrigin(getRelativeLocaleUrl(lang, 'freelance'), 'experience');
const ctaLabel = t.bannerCta.replace('{count}', String(projectCount));
---

<a href={freelancePath} class="freelance-banner">
  <span class="freelance-banner-label">{t.bannerLabel}</span>
  <p class="freelance-banner-description">{t.bannerDescription}</p>
  <span class="freelance-banner-cta">
    {ctaLabel}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  </span>
</a>

<style>
  .freelance-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    border: 3px solid var(--color-text);
    background-color: var(--timeline-item-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.2s ease;
    max-width: 42rem;
  }

  .freelance-banner:hover {
    transform: translate(4px, -4px);
    box-shadow: -4px 4px 0 var(--color-accent);
  }

  .freelance-banner-label {
    font-family: var(--font-family-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .freelance-banner-description {
    font-family: var(--font-family-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
  }

  .freelance-banner-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    font-family: var(--font-family-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .freelance-banner-cta svg {
    transition: transform 0.2s ease;
  }

  .freelance-banner:hover .freelance-banner-cta svg {
    transform: translateX(4px);
  }
</style>
