---
import { getTranslations, type Language } from '@/i18n/translations';
import '../styles/segmented-control.css';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const contactT = getTranslations(lang).contact;
const t = contactT.form;

// Get Turnstile site key in frontmatter (server-side) to pass to client script
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<form id="contact-form" class="contact-form" data-intent="cv">
  <input type="hidden" id="contact-intent" name="intent" value="cv" />
  <input type="hidden" id="project-type" name="projectType" value="" />

  <div class="form-group">
    <label for="name" class="form-label">{t.name} <span class="form-required" aria-hidden="true">*</span></label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder={t.namePlaceholder}
      required
      class="form-input"
    />
    <span class="error-message" id="name-error"></span>
  </div>

  <div class="form-group">
    <label for="email" class="form-label">{t.email} <span class="form-required" aria-hidden="true">*</span></label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder={t.emailPlaceholder}
      required
      class="form-input"
    />
    <span class="error-message" id="email-error"></span>
  </div>

  <div class="form-group intent-field intent-field--cv" data-intent-field="cv">
    <label for="company" class="form-label">{t.company} <span class="form-required" aria-hidden="true">*</span></label>
    <input
      type="text"
      id="company"
      name="company"
      placeholder={t.companyPlaceholder}
      required
      class="form-input"
    />
    <span class="error-message" id="company-error"></span>
  </div>

  <div class="form-group intent-field intent-field--freelance" data-intent-field="freelance" hidden>
    <span class="form-label" id="project-type-label">{contactT.projectType.label} <span class="form-required" aria-hidden="true">*</span></span>
    <div
      class="segmented-control segmented-control--project-type"
      id="project-type-switcher"
      role="radiogroup"
      aria-labelledby="project-type-label"
      data-has-selection="false"
      data-position="0"
    >
      <div class="segmented-control__indicator" aria-hidden="true"></div>

      <button
        type="button"
        class="segmented-control__option"
        role="radio"
        aria-checked="false"
        data-project-type="mobile"
      >
        <span class="segmented-control__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
        </span>
        <span>{contactT.projectType.mobile}</span>
      </button>

      <button
        type="button"
        class="segmented-control__option"
        role="radio"
        aria-checked="false"
        data-project-type="web"
      >
        <span class="segmented-control__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </span>
        <span>{contactT.projectType.web}</span>
      </button>
    </div>
    <span class="error-message" id="projectType-error"></span>
  </div>

  <!-- Honeypot field -->
  <input
    type="text"
    name="website"
    id="website"
    class="honeypot"
    tabindex="-1"
    autocomplete="off"
  />

  <!-- Cloudflare Turnstile CAPTCHA (interaction-only: visible only when a challenge is required) -->
  <div class="turnstile-group" id="turnstile-form-group" hidden={!turnstileSiteKey}>
    <div id="turnstile-widget" class="turnstile-container"></div>
    <input type="hidden" id="turnstile-token" name="turnstileToken" />
  </div>
  <div class="turnstile-status" id="turnstile-status" role="alert" hidden>
    <span class="turnstile-error" id="turnstile-error"></span>
    <button type="button" class="turnstile-retry" id="turnstile-retry">{t.captcha.retry}</button>
  </div>

  <button type="submit" class="submit-btn" id="submit-btn">
    <span id="submit-text">{contactT.intents.cv.submit}</span>
  </button>

  <div class="form-message" id="form-message"></div>
</form>

<style>
  .contact-form {
    max-width: 600px;
    border: 3px solid var(--color-text);
    padding: 2rem;
    background-color: var(--timeline-item-bg);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .form-required {
    color: var(--color-required);
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-family-sans);
    font-size: 1rem;
    border: 2px solid var(--color-text);
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    transform: translate(2px, -2px);
    box-shadow: -2px 2px 0 var(--color-text);
  }

  .form-select {
    cursor: pointer;
  }

  .error-message {
    display: none; /* Hidden by default */
    font-size: 0.875rem;
    color: #dc2626;
    margin-top: 0.25rem;
    min-height: 1.25rem;
  }
  
  .error-message:not(:empty) {
    display: block; /* Show when there's content */ 
  }

  .submit-btn {
    width: 100%;
    padding: 1rem 2rem;
    font-family: var(--font-family-sans);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-accent);
    color: var(--color-bg);
    border: 3px solid var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  #submit-text {
    font-weight: bold;
  }

  .submit-btn:hover:not(:disabled) {
    transform: translate(4px, -4px);
    box-shadow: -4px 4px 0 var(--color-text);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-message {
    margin-top: 1rem;
    padding: 1rem;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    text-align: center;
    border: 2px solid transparent;
    display: block; /* Always show when there's content */
    min-height: 2.5rem; /* Reserve space for message */
  }

  .form-message.success {
    border-color: #16a34a;
    background-color: #dcfce7;
    color: #15803d;
  }

  .form-message.error {
    border-color: #dc2626;
    background-color: #fee2e2;
    color: #991b1b;
  }

  .form-message:empty {
    display: none;
  }

  /* Honeypot hidden field */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }

  .turnstile-group[hidden],
  .turnstile-status[hidden] {
    display: none;
  }

  .turnstile-container {
    display: flex;
    justify-content: center;
  }

  .turnstile-group--interactive {
    margin-bottom: 1.5rem;
  }

  .turnstile-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .turnstile-error {
    font-size: 0.875rem;
    color: var(--color-required);
  }

  .turnstile-retry {
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 2px solid var(--color-text);
    background-color: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .turnstile-retry:hover {
    transform: translate(2px, -2px);
    box-shadow: -2px 2px 0 var(--color-text);
  }

  .intent-field[hidden] {
    display: none !important;
  }

  .segmented-control--project-type {
    margin-top: 0.5rem;
  }
</style>

<script define:vars={{ t, contactT, lang, turnstileSiteKey }}>
  // Wait for DOM to be ready
  (function() {
    const form = document.getElementById('contact-form');
    if (!form) {
      return;
    }
    
    const submitBtn = document.getElementById('submit-btn');
    const submitText = document.getElementById('submit-text');
    const formMessage = document.getElementById('form-message');
    const turnstileTokenInput = document.getElementById('turnstile-token');
    const turnstileError = document.getElementById('turnstile-error');
    const turnstileStatus = document.getElementById('turnstile-status');
    const turnstileRetry = document.getElementById('turnstile-retry');
    const turnstileGroup = document.getElementById('turnstile-form-group');
    const intentInput = document.getElementById('contact-intent');
    const projectTypeInput = document.getElementById('project-type');
    const projectTypeSwitcher = document.getElementById('project-type-switcher');
    const companyInput = document.getElementById('company');
    const companyField = document.querySelector('[data-intent-field="cv"]');
    const freelanceField = document.querySelector('[data-intent-field="freelance"]');
    
    if (!submitBtn || !submitText || !formMessage) {
      return;
    }

    const getIntent = () => {
      const value = intentInput?.value || form.dataset.intent || 'cv';
      return value === 'freelance' ? 'freelance' : 'cv';
    };

    const getSubmitLabel = (intent = getIntent()) =>
      intent === 'freelance' ? contactT.intents.freelance.submit : contactT.intents.cv.submit;

    const getSuccessLabel = (intent = getIntent()) =>
      intent === 'freelance' ? contactT.intents.freelance.success : contactT.intents.cv.success;

    const applyIntentUi = (intent) => {
      form.dataset.intent = intent;
      if (intentInput) intentInput.value = intent;

      if (companyField instanceof HTMLElement) {
        companyField.hidden = intent !== 'cv';
      }
      if (freelanceField instanceof HTMLElement) {
        freelanceField.hidden = intent !== 'freelance';
      }
      if (companyInput instanceof HTMLInputElement) {
        companyInput.required = intent === 'cv';
      }

      if (submitText && !submitBtn.disabled) {
        submitText.textContent = getSubmitLabel(intent);
      }
    };

    const resetProjectType = () => {
      if (projectTypeInput) projectTypeInput.value = '';
      if (!projectTypeSwitcher) return;

      projectTypeSwitcher.setAttribute('data-has-selection', 'false');
      projectTypeSwitcher.setAttribute('data-position', '0');
      projectTypeSwitcher.querySelectorAll('[role="radio"]').forEach((option) => {
        option.setAttribute('aria-checked', 'false');
      });

      const projectTypeError = document.getElementById('projectType-error');
      if (projectTypeError) {
        projectTypeError.textContent = '';
        projectTypeError.style.display = 'none';
      }
    };

    const setProjectType = (projectType) => {
      if (!projectTypeSwitcher || !projectTypeInput) return;

      projectTypeInput.value = projectType;
      const index = projectType === 'web' ? 1 : 0;
      projectTypeSwitcher.setAttribute('data-has-selection', 'true');
      projectTypeSwitcher.setAttribute('data-position', String(index));

      projectTypeSwitcher.querySelectorAll('[role="radio"]').forEach((option) => {
        const isSelected = option.getAttribute('data-project-type') === projectType;
        option.setAttribute('aria-checked', isSelected ? 'true' : 'false');
      });

      const projectTypeError = document.getElementById('projectType-error');
      if (projectTypeError) {
        projectTypeError.textContent = '';
        projectTypeError.style.display = 'none';
      }
    };

    if (!document.documentElement.dataset.contactProjectTypeBound) {
      document.documentElement.dataset.contactProjectTypeBound = 'true';

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const option = target.closest('#project-type-switcher [role="radio"]');
        if (!(option instanceof HTMLElement)) return;

        const projectType = option.getAttribute('data-project-type');
        if (projectType !== 'mobile' && projectType !== 'web') return;

        const switcher = document.getElementById('project-type-switcher');
        const projectTypeInput = document.getElementById('project-type');
        if (!(switcher instanceof HTMLElement) || !(projectTypeInput instanceof HTMLInputElement)) {
          return;
        }

        projectTypeInput.value = projectType;
        const index = projectType === 'web' ? 1 : 0;
        switcher.setAttribute('data-has-selection', 'true');
        switcher.setAttribute('data-position', String(index));

        switcher.querySelectorAll('[role="radio"]').forEach((radio) => {
          const isSelected = radio.getAttribute('data-project-type') === projectType;
          radio.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        });

        const projectTypeError = document.getElementById('projectType-error');
        if (projectTypeError instanceof HTMLElement) {
          projectTypeError.textContent = '';
          projectTypeError.style.display = 'none';
        }
      });
    }

    if (!document.documentElement.dataset.contactIntentChangeBound) {
      document.documentElement.dataset.contactIntentChangeBound = 'true';

      document.addEventListener('contact:intent-change', (event) => {
        const intent = event.detail?.intent;
        if (intent !== 'cv' && intent !== 'freelance') return;

        const liveForm = document.getElementById('contact-form');
        if (!(liveForm instanceof HTMLFormElement)) return;

        const liveIntentInput = document.getElementById('contact-intent');
        const liveCompanyField = document.querySelector('[data-intent-field="cv"]');
        const liveFreelanceField = document.querySelector('[data-intent-field="freelance"]');
        const liveCompanyInput = document.getElementById('company');
        const liveSubmitBtn = document.getElementById('submit-btn');
        const liveSubmitText = document.getElementById('submit-text');

        liveForm.dataset.intent = intent;
        if (liveIntentInput instanceof HTMLInputElement) {
          liveIntentInput.value = intent;
        }
        if (liveCompanyField instanceof HTMLElement) {
          liveCompanyField.hidden = intent !== 'cv';
        }
        if (liveFreelanceField instanceof HTMLElement) {
          liveFreelanceField.hidden = intent !== 'freelance';
        }
        if (liveCompanyInput instanceof HTMLInputElement) {
          liveCompanyInput.required = intent === 'cv';
        }
        if (
          liveSubmitText instanceof HTMLElement &&
          liveSubmitBtn instanceof HTMLButtonElement &&
          !liveSubmitBtn.disabled
        ) {
          liveSubmitText.textContent =
            intent === 'freelance'
              ? contactT.intents.freelance.submit
              : contactT.intents.cv.submit;
        }

        if (intent === 'cv') {
          const switcher = document.getElementById('project-type-switcher');
          const projectTypeInput = document.getElementById('project-type');
          if (switcher instanceof HTMLElement) {
            switcher.setAttribute('data-has-selection', 'false');
            switcher.setAttribute('data-position', '0');
            switcher.querySelectorAll('[role="radio"]').forEach((option) => {
              option.setAttribute('aria-checked', 'false');
            });
          }
          if (projectTypeInput instanceof HTMLInputElement) {
            projectTypeInput.value = '';
          }
          const projectTypeError = document.getElementById('projectType-error');
          if (projectTypeError instanceof HTMLElement) {
            projectTypeError.textContent = '';
            projectTypeError.style.display = 'none';
          }
        }
      });
    }

    applyIntentUi(getIntent());

    const TURNSTILE_SCRIPT_TIMEOUT_MS = 15000;

    /** @type {string|null} */
    let turnstileWidgetId = null;
    /** @type {'disabled'|'loading'|'ready'|'error'} */
    let captchaState = turnstileSiteKey ? 'loading' : 'disabled';

    const syncSubmitState = () => {
      const canSubmit = captchaState === 'disabled' || captchaState === 'ready';
      submitBtn.disabled = !canSubmit;
      submitText.textContent = captchaState === 'loading' ? t.captcha.verifying : getSubmitLabel();
    };

    const hideCaptchaStatus = () => {
      if (turnstileStatus) turnstileStatus.hidden = true;
      if (turnstileError) turnstileError.textContent = '';
    };

    const showCaptchaStatus = (message) => {
      if (turnstileError) turnstileError.textContent = message;
      if (turnstileStatus) turnstileStatus.hidden = false;
    };

    const setCaptchaLoading = () => {
      captchaState = 'loading';
      if (turnstileTokenInput) turnstileTokenInput.value = '';
      hideCaptchaStatus();
      syncSubmitState();
    };

    const setCaptchaReady = (token) => {
      captchaState = 'ready';
      if (turnstileTokenInput) turnstileTokenInput.value = token;
      hideCaptchaStatus();
      syncSubmitState();
    };

    const setCaptchaError = (message) => {
      captchaState = 'error';
      if (turnstileTokenInput) turnstileTokenInput.value = '';
      showCaptchaStatus(message);
      syncSubmitState();
    };

    /** Loads api.js once per document; survives ClientRouter head swaps via window state. */
    const loadTurnstile = () => {
      if (window.turnstile) return Promise.resolve(window.turnstile);
      if (window.__turnstileLoading) return window.__turnstileLoading;

      window.__turnstileLoading = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        const timeoutId = setTimeout(() => fail('script_load_timeout'), TURNSTILE_SCRIPT_TIMEOUT_MS);

        function fail(reason) {
          clearTimeout(timeoutId);
          window.__turnstileLoading = null;
          script.remove();
          reject(new Error(reason));
        }

        window.__onTurnstileLoad = () => {
          clearTimeout(timeoutId);
          resolve(window.turnstile);
        };

        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__onTurnstileLoad';
        script.async = true;
        script.onerror = () => fail('script_load_error');
        document.head.appendChild(script);
      });

      return window.__turnstileLoading;
    };

    const resetCaptcha = () => {
      if (!turnstileSiteKey) return;
      turnstileGroup?.classList.remove('turnstile-group--interactive');
      setCaptchaLoading();
      if (turnstileWidgetId !== null && window.turnstile) {
        window.turnstile.reset(turnstileWidgetId);
      } else {
        initTurnstile();
      }
    };

    const renderTurnstile = (turnstile) => {
      const container = document.getElementById('turnstile-widget');
      if (!container || !container.isConnected) return;

      if (turnstileWidgetId !== null) {
        turnstile.remove(turnstileWidgetId);
        turnstileWidgetId = null;
      }

      turnstileWidgetId = turnstile.render(container, {
        sitekey: turnstileSiteKey,
        language: lang,
        appearance: 'interaction-only',
        retry: 'auto',
        'refresh-expired': 'auto',
        'refresh-timeout': 'auto',
        callback: (token) => setCaptchaReady(token),
        'before-interactive-callback': () => {
          turnstileGroup?.classList.add('turnstile-group--interactive');
        },
        'expired-callback': () => setCaptchaLoading(),
        'timeout-callback': () => setCaptchaError(t.captcha.timeout),
        'error-callback': (code) => {
          setCaptchaError(`${t.captcha.failed} (${code})`);
        },
      });
    };

    const initTurnstile = () => {
      if (!turnstileSiteKey) {
        if (turnstileTokenInput) turnstileTokenInput.value = 'disabled';
        syncSubmitState();
        return;
      }

      setCaptchaLoading();
      loadTurnstile()
        .then(renderTurnstile)
        .catch((error) => {
          const reason = error instanceof Error ? error.message : 'render_error';
          setCaptchaError(`${t.captcha.failed} (${reason})`);
        });
    };

    turnstileRetry?.addEventListener('click', resetCaptcha);

    document.addEventListener('astro:before-swap', () => {
      if (turnstileWidgetId !== null && window.turnstile) {
        window.turnstile.remove(turnstileWidgetId);
        turnstileWidgetId = null;
      }
    }, { once: true });

    syncSubmitState();
    
    // Form data persistence across language changes
    const FORM_STORAGE_KEY = 'contact-form-data';
    
    // Save form data to sessionStorage
    const saveFormData = () => {
      const nameInput = document.getElementById('name');
      const emailInput = document.getElementById('email');
      
      const formData = {
        name: nameInput?.value || '',
        email: emailInput?.value || '',
        company: companyInput?.value || '',
        projectType: projectTypeInput?.value || '',
      };
      sessionStorage.setItem(FORM_STORAGE_KEY, JSON.stringify(formData));
    };
    
    // Restore form data from sessionStorage
    const restoreFormData = () => {
      try {
        const savedData = sessionStorage.getItem(FORM_STORAGE_KEY);
        if (savedData) {
          const formData = JSON.parse(savedData);
          const nameInput = document.getElementById('name');
          const emailInput = document.getElementById('email');
          
          if (nameInput && formData.name) nameInput.value = formData.name;
          if (emailInput && formData.email) emailInput.value = formData.email;
          if (companyInput && formData.company) companyInput.value = formData.company;
          if (formData.projectType === 'mobile' || formData.projectType === 'web') {
            setProjectType(formData.projectType);
          }
        }
      } catch (e) {
        // Silently fail - form data restoration is not critical
      }
    };
    
    // Clear form data from sessionStorage (after successful submission)
    const clearFormData = () => {
      sessionStorage.removeItem(FORM_STORAGE_KEY);
    };
    
    // Save form data on input changes
    const formInputs = form.querySelectorAll('input[type="text"], input[type="email"]');
    formInputs.forEach(input => {
      input.addEventListener('input', saveFormData);
      input.addEventListener('change', saveFormData);
    });
    
    // Save form data before language change
    const langSwitcher = document.querySelector('.lang-switcher');
    if (langSwitcher) {
      langSwitcher.addEventListener('click', () => {
        saveFormData();
        // Set a flag to indicate language change
        sessionStorage.setItem('language-changing', 'true');
      });
    }
    
    // Restore form data on page load (if coming from language change)
    const isLanguageChange = sessionStorage.getItem('language-changing') === 'true';
    if (isLanguageChange) {
      // Small delay to ensure DOM is ready
      setTimeout(() => {
        restoreFormData();
        sessionStorage.removeItem('language-changing');
      }, 100);
    }
    
    initTurnstile();

    // Attach form submit handler
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const intent = getIntent();
      
      // Clear previous errors
      document.querySelectorAll('.error-message').forEach(el => {
        el.textContent = '';
        el.style.display = 'none';
      });
      formMessage.textContent = '';
      formMessage.className = 'form-message';
      formMessage.style.display = 'none';

      if (intent === 'freelance') {
        const projectType = projectTypeInput?.value || '';
        if (projectType !== 'mobile' && projectType !== 'web') {
          const projectTypeError = document.getElementById('projectType-error');
          if (projectTypeError) {
            projectTypeError.textContent = contactT.projectType.required;
            projectTypeError.style.display = 'block';
          }
          return;
        }
      }
      
      const turnstileToken = turnstileTokenInput?.value || '';

      if (turnstileSiteKey && (captchaState !== 'ready' || !turnstileToken)) {
        showCaptchaStatus(t.captcha.required);
        return;
      }
      
      // Disable submit button
      submitBtn.disabled = true;
      submitText.textContent = t.submitting;
      
      // Get form data
      const formData = new FormData(form);
      const baseData = {
        name: formData.get('name'),
        email: formData.get('email'),
        language: lang,
        website: formData.get('website') || '', // Honeypot
        turnstileToken: turnstileToken || 'disabled',
      };

      const data = intent === 'freelance'
        ? {
            ...baseData,
            projectType: formData.get('projectType'),
          }
        : {
            ...baseData,
            company: formData.get('company') || '',
          };

      const endpoint = intent === 'freelance' ? '/api/freelance-inquiry' : '/api/request-cv';
      
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        
        // Read response body once (can only be read once)
        let responseText;
        try {
          responseText = await response.text();
        } catch (e) {
          formMessage.textContent = 'Failed to read server response. Please try again.';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }
        
        // Check if response is OK
        if (!response.ok) {
          // Try to parse error response as JSON
          let errorMessage = `Server error: ${response.status} ${response.statusText}`;
          try {
            const errorData = JSON.parse(responseText);
            errorMessage = errorData.error || errorData.message || errorMessage;
          } catch (e) {
            // Response is not JSON, use the text as-is
            errorMessage = responseText || errorMessage;
          }
          
          formMessage.textContent = errorMessage;
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }
        
        // Parse JSON response
        let result;
        try {
          result = JSON.parse(responseText);
        } catch (e) {
          formMessage.textContent = 'Invalid response from server. Please try again.';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }
        
        if (result.success) {
          formMessage.textContent = getSuccessLabel(intent);
          formMessage.className = 'form-message success';
          formMessage.style.display = 'block';
          form.reset();
          applyIntentUi(intent);
          if (intent === 'freelance') {
            resetProjectType();
          }
          
          // Clear saved form data after successful submission
          clearFormData();
        } else {
          // Handle validation errors
          if (result.errors) {
            Object.entries(result.errors).forEach(([field, messages]) => {
              const errorEl = document.getElementById(`${field}-error`);
              if (errorEl && Array.isArray(messages) && messages.length > 0) {
                errorEl.textContent = messages[0];
                errorEl.style.display = 'block';
              }
            });
          }
          
          // Show main error message
          const errorText = result.error || t.error || 'An error occurred. Please try again.';
          formMessage.textContent = errorText;
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
        }
      } catch (error) {
        // Network error or other exception
        const errorText = error instanceof Error 
          ? `Network error: ${error.message}` 
          : 'Failed to submit form. Please check your connection and try again.';
        
        formMessage.textContent = errorText;
        formMessage.className = 'form-message error';
        formMessage.style.display = 'block';
      } finally {
        // Turnstile tokens are single-use: always request a fresh one after a submit attempt
        resetCaptcha();
        syncSubmitState();
      }
    });
  })();
</script>
